# Beispielwerte – echte Werte nur im Portainer-Stack bzw. in einer lokalen .env (nicht einchecken)
STACK=fernblick-spiele
IMAGE=ghcr.io/<owner>/fernblick-spiele
IMAGE_TAG=sha-<commit>
SPIELE_HOST=spiele.example.org
DATEN_PFAD=/srv/fernblick-spiele
# Familien-Kennwort für die Anmeldung (Wechsel beendet alle Sitzungen)
SPIELE_KENNWORT=
# Containername oder IP des Reverse-Proxys (für die Fehlversuch-Sperre je IP)
TRUSTED_PROXIES=traefik
# Fernblick-Planer, von dem die Hauswelt geholt wird, und das gemeinsame Token (im Planer: SPIELWELT_TOKEN)
PLANER_URL=https://planer.example.org
SPIELWELT_TOKEN=
TRAEFIK_NETWORK=traefik
TRAEFIK_CERTRESOLVER=letsencrypt
# optional, z. B. Rate-Limit und Sicherheits-Header
TRAEFIK_MIDDLEWARES=
